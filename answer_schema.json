{
  "title": "BPMN structured answer",
  "description": "A concise answer containing only the information explicitly requested by the user.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "answer_type": {
      "type": "string",
      "enum": [
        "list",
        "value",
        "ranking",
        "path",
        "comparison",
        "finding"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "no_results",
        "empty_mcp_response",
        "not_represented",
        "not_applicable"
      ]
    },
    "results": {
      "type": "array",
      "description": "The complete set of primary answer targets. Context, container and classification entities must not be used as roots unless they are themselves the requested targets. Include every root identifier exactly once.",
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "required": [
    "answer_type",
    "status",
    "results"
  ],
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "type": [
            "string",
            "null"
          ],
          "description": "The exact source identifier or null only when the answer is not an identified entity."
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "element_type": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "rank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "attributes": {
          "type": "array",
          "description": "Only properties explicitly requested by the question; otherwise: an empty array.",
          "items": {
            "$ref": "#/$defs/attribute"
          }
        },
        "related_elements": {
          "type": "array",
          "description": "Entities explicitly required to qualify the enclosing root result. Every relation is directed from the enclosing result toward the related element. Otherwise, return an empty array. Do not recursively expand related elements.",
          "items": {
            "$ref": "#/$defs/related_element"
          }
        }
      },
      "required": [
        "identifier",
        "label",
        "element_type",
        "rank",
        "attributes",
        "related_elements"
      ]
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "value",
        "unit"
      ]
    },
    "related_element": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "The evidence-grounded relation from the enclosing result to this related element, expressed in snake_case."
        },
        "identifier": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "element_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "order": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "relation",
        "identifier",
        "label",
        "element_type",
        "order"
      ]
    }
  }
}